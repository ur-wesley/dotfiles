// Wesley's zellij default layout — single fish pane + bottom tab bar.
//
// Critical detail: panes inside default_tab_template that all have
// `size=1` share the available height EQUALLY (50/50). To get a
// full-height shell pane + a fixed 1-row tab bar, the shell pane
// must have NO `size` attribute (grows to fill) and the tab-bar
// pane must keep `size=1`.
//
// Resizes gracefully to any terminal size — the fish pane fills
// whatever vertical space the tab bar doesn't use.

layout {
    // The default template applied when a new tab is opened.
    default_tab_template {
        // First pane: shell (fish) — fills all available height.
        // NO `size=` attribute means "grow to fill remaining space".
        pane {
            command "fish"
        }
        // Tab bar pinned to the bottom — fixed at 1 row.
        // borderless=true so the tab bar doesn't take any extra
        // padding. With `hide-if-single=true` (zellij's default),
        // this pane only renders when 2+ tabs exist.
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar" {
                tab_bar_position "bottom"
            }
        }
    }
}