// Wesley's zellij default layout — single pane, fish shell.
// Tab bar at the bottom. Resizes gracefully to any terminal size.
layout {
    default_tab_template {
        // Single pane that fills the terminal.
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar" {
                // Bottom tab bar — matches the theme's ribbon style.
                tab_bar_position "bottom"
            }
        }
    }
}

// Optional pane tree — currently empty so zellij starts with one pane.
// User splits on demand via Ctrl+P then n (below) / s (side) / v (vertical stack).