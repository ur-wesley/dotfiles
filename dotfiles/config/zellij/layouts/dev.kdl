// Wesley's zellij default layout — single fish pane + bottom tab bar.
// Splits happen on demand via Ctrl+P then n (below) / s (side) / v (vertical).
// Resizes gracefully to any terminal size.
layout {
    // The default template applied when a new tab is opened.
    default_tab_template {
        // First pane: shell (fish) — fills the tab.
        pane size=1 {
            // The fish shell inside WSL. zellij will use $SHELL if this
            // is omitted, but being explicit makes session recovery easier.
            command "fish"
        }
        // Tab bar pinned to the bottom — only shown when 2+ tabs exist
        // (because zellij's hide-if-single plugin setting is on by default).
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar" {
                tab_bar_position "bottom"
            }
        }
    }
}