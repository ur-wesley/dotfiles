// Wesley's zellij layout — omerxx-style tmux layout.
// Tab bar at bottom, single fish pane that fills the rest.
// Like tmux: tab bar visible when 2+ tabs exist.

layout {
    default_tab_template {
        // Fish pane — fills all available space.
        pane borderless=true {
            command "fish"
        }
        // Tab bar at bottom — visible when 2+ tabs.
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar" {
                tab_bar_position "bottom"
            }
        }
    }
}